# Keep source files normalized in the repository and on GitHub.
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows launchers are intentionally CRLF for cmd.exe compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never diff generated/binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.safetensors binary
*.ckpt binary
*.pth binary
*.pt binary
*.bin binary
